    {
      "id": "depth",
      "scope": "node",
      "kinds": [
        "weapon",
        "tool",
        "charter",
        "item",
        "evolution",
        "enemy",
        "vassal"
      ],
      "value": {
        "op": "case",
        "cases": [
          {
            "when": {
              "op": "not",
              "value": {
                "op": "get",
                "from": "vars",
                "path": [
                  "selected"
                ]
              }
            },
            "value": "design"
          },
          {
            "when": {
              "op": "any",
              "input": {
                "op": "get",
                "from": "node",
                "path": [
                  "runtimeProjection",
                  "effects"
                ]
              },
              "where": {
                "op": "ne",
                "left": {
                  "op": "get",
                  "from": "item",
                  "path": [
                    "operation"
                  ]
                },
                "right": "stat-add"
              }
            },
            "value": "unique"
          },
          {
            "when": {
              "op": "in",
              "value": {
                "op": "get",
                "from": "node",
                "path": [
                  "kind"
                ]
              },
              "collection": {
                "op": "literal",
                "value": [
                  "weapon",
                  "tool",
                  "enemy"
                ]
              }
            },
            "value": "base"
          },
          {
            "when": {
              "op": "and",
              "values": [
                {
                  "op": "gt",
                  "left": {
                    "op": "count",
                    "value": {
                      "op": "get",
                      "from": "node",
                      "path": [
                        "runtimeProjection",
                        "effects"
                      ]
                    }
                  },
                  "right": 0
                },
                {
                  "op": "all",
                  "input": {
                    "op": "get",
                    "from": "node",
                    "path": [
                      "runtimeProjection",
                      "effects"
                    ]
                  },
                  "where": {
                    "op": "eq",
                    "left": {
                      "op": "get",
                      "from": "item",
                      "path": [
                        "operation"
                      ]
                    },
                    "right": "stat-add"
                  }
                }
              ]
            },
            "value": "stat"
          }
        ],
        "default": "design"
      }
