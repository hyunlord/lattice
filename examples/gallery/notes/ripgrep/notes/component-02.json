  "claims": [
    {
      "purpose": "component-name",
      "text": "Arguments and configuration",
      "citations": [
        {
          "path": "crates/core/flags/mod.rs",
          "contentHash": "73bfbf149d375461e7b57d3967a5ee9c8a1875fad258f53c4c93083687348b71",
          "startLine": 1,
          "endLine": 10,
          "excerpt": "/*!\nDefines ripgrep's command line interface.\n\nThis modules deals with everything involving ripgrep's flags and positional\narguments. This includes generating shell completions, `--help` output and even\nripgrep's man page. It's also responsible for parsing and validating every\nflag (including reading ripgrep's config file), and manages the contact points\nbetween these flags and ripgrep's cast of supporting libraries. For example,\nonce [`HiArgs`] has been created, it knows how to create a multi threaded\nrecursive directory traverser."
        }
      ]
    },
