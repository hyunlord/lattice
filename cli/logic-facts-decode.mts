function definition(value: unknown): LogicDefinition { const item = object(value); return { id: text(item['id']), name: text(item['name']), line: number(item['line']), endLine: number(item['endLine']), start: number(item['start']), end: number(item['end']), parent: text(item['parent']), scopeStart: number(item['scopeStart']), scopeEnd: number(item['scopeEnd']), owner: text(item['owner']), static: bool(item['static']), exported: bool(item['exported']), exportNames: array(item['exportNames'], text), bindings: array(item['bindings'], text), annotations: array(item['annotations'], text) }; }
function call(value: unknown): LogicCall { const item = object(value); return { caller: text(item['caller']), name: text(item['name']), receiver: text(item['receiver']), line: number(item['line']), endLine: number(item['endLine']), start: number(item['start']), callbackIds: array(item['callbackIds'], text), route: bool(item['route']) }; }
function binding(value: unknown): LogicImport { const item = object(value); return { local: text(item['local']), imported: text(item['imported']), specifier: text(item['specifier']), namespace: bool(item['namespace']), ...(item['exported'] === undefined ? {} : { exported: bool(item['exported']) }), scopeStart: number(item['scopeStart']), scopeEnd: number(item['scopeEnd']), line: number(item['line']) }; }
function diagnostic(value: unknown): LogicDiagnostic { const item = object(value); return { code: text(item['code']), path: text(item['path']), line: number(item['line']), message: text(item['message']) }; }
export function decodeLogicFacts(value: unknown): LogicFacts {
    const item = object(value);
    if (item['version'] !== 1) throw new GraphInputError('logic', 'Unsupported cached logic version');
    return { version: 1, path: text(item['path']), language: text(item['language']), contentHash: text(item['contentHash']), supported: bool(item['supported']), definitions: array(item['definitions'], definition), calls: array(item['calls'], call), imports: array(item['imports'], binding), topBindings: array(item['topBindings'], text), classes: array(item['classes'], value => { const item = object(value); return { name: text(item['name']), bases: array(item['bases'], text), annotations: array(item['annotations'], text), line: number(item['line']) }; }), diagnostics: array(item['diagnostics'], diagnostic) };
}
