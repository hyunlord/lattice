import type { LogicFacts, LogicDefinition, LogicCall, LogicImport, LogicDiagnostic } from '../dist/adapters/logic-types.js';
function object(value: unknown): Record<string, unknown> { if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new GraphInputError('logic', 'Invalid cached logic object'); return Object.fromEntries(Object.entries(value)); }
