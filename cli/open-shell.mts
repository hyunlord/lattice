export function openShell(): string {
    return `<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Lattice</title><link rel="stylesheet" href="/styles.css"><style>main{max-width:1080px;margin:auto}.open-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:var(--space-4)}.open-grid .panel{margin-bottom:var(--space-4)}#open-paths{max-height:360px;overflow:auto;overflow-wrap:anywhere}#open-detail,#open-description-source{overflow-wrap:anywhere}#open-description{white-space:pre-wrap}.open-progress{border-left:4px solid var(--accent);margin-block:var(--space-6);padding:var(--space-4);background:var(--surface)}</style></head><body><header class="topbar"><a class="brand" href="/">Lattice</a><label>언어 / Language <select id="open-language"><option value="ko">한국어</option><option value="en">English</option></select></label></header><main data-open-shell><h1 id="open-title">저장소 열기</h1><p id="open-intro" class="muted">소스에서 확인한 내용을 먼저 보여주고, 분석이 끝나면 전체 지도를 엽니다.</p><section class="open-progress" role="status" aria-live="polite"><h2 id="open-phase">서버 준비 완료</h2><p id="open-detail"></p></section><div id="open-inventory" hidden><section class="panel section"><h2 id="open-repository"></h2><p id="open-count"></p><p id="open-description"></p><p id="open-description-source" class="meta"></p></section><p id="open-pending" class="muted"></p><div class="open-grid"><section class="panel"><h2 id="open-manifests-title">매니페스트 근거</h2><div id="open-manifests"></div></section><section class="panel"><h2 id="open-paths-title">확인한 파일 표본</h2><ul id="open-paths"></ul></section></div></div></main></body></html>`;
}
